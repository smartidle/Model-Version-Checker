<Window x:Class="ModelVersionChecker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModelVersionChecker.ViewModels"
        xmlns:converters="clr-namespace:ModelVersionChecker.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding AppTitle}"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        Icon="pack://application:,,,/Resources/app-icon.png"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === 配置区域 === -->
        <GroupBox Grid.Row="0" Header="{Binding ConfigHeader}" Background="White" BorderBrush="#D0D5DD">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 语言选择 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LanguageLabel}" VerticalAlignment="Center"
                           FontSize="14" Foreground="#333"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedIndex="{Binding SelectedLanguageIndex}"
                          FontSize="14" Height="32"
                          Padding="8,4"/>

                <!-- 提供商选择 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ProviderLabel}" VerticalAlignment="Center"
                           FontSize="14" Foreground="#333"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          DisplayMemberPath="DisplayName"
                          FontSize="14" Height="32"
                          Padding="8,4"/>

                <!-- API Key 输入 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ApiKeyLabel}" VerticalAlignment="Center"
                           FontSize="14" Foreground="#333"/>
                <Grid Grid.Row="4" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0"
                                 FontSize="14" Height="32" Padding="8,4"
                                 PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>
                    <TextBox x:Name="ApiKeyTextBox" Grid.Column="0"
                             FontSize="14" Height="32" Padding="8,4"
                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed"/>
                    <ToggleButton Grid.Column="1" x:Name="TogglePasswordBtn"
                                  Content="👁" Width="36" Height="32"
                                  FontSize="16" Margin="4,0,0,0"
                                  Click="TogglePasswordVisibility"/>
                </Grid>

                <!-- API Key 提示 -->
                <TextBlock Grid.Row="6" Grid.Column="1"
                           Text="{Binding ApiKeyHint}"
                           FontSize="12" Foreground="#888" Margin="0,2,0,0"/>

                <!-- 查询按钮 -->
                <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding QueryButtonText}"
                        Command="{Binding QueryCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#4472C4" Foreground="White"
                        FontWeight="Medium"
                        HorizontalAlignment="Center"
                        Height="38" Width="220"/>
            </Grid>
        </GroupBox>

        <!-- === 查询结果区域 === -->
        <GroupBox Grid.Row="1" Header="{Binding ResultHeader}" Background="White" BorderBrush="#D0D5DD" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 结果计数 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding FoundText}" FontSize="13" Foreground="#555"/>
                    <TextBlock Text="{Binding ResultCount}" FontSize="13" Foreground="#4472C4" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ModelsText}" FontSize="13" Foreground="#555"/>
                </StackPanel>

                <!-- 加载动画 -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding LoadingText}" FontSize="16" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 空状态 -->
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding EmptyStateText}"
                           FontSize="15" Foreground="#999"
                           Visibility="{Binding HasResults, Converter={StaticResource InvBoolToVis}}"/>

                <!-- 数据表格 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Models}"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColModelId, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding ModelId}" Width="*"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColProvider, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Provider}" Width="120"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColCreatedDate, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding CreatedDate}" Width="160"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColOwner, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding OwnedBy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- === 导出按钮栏 === -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Content="{Binding ExportCsvButton}"
                    Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#5B9BD5" Foreground="White"
                    Margin="0,0,12,0"/>
            <Button Content="{Binding ExportExcelButton}"
                    Command="{Binding ExportExcelCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#70AD47" Foreground="White"
                    Margin="0,0,12,0"/>
            <Button Content="{Binding CopyClipboardButton}"
                    Command="{Binding CopyToClipboardCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#ED7D31" Foreground="White"/>
        </StackPanel>

        <!-- === 状态栏 === -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D0D5DD" BorderThickness="1"
                CornerRadius="4" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="13" Foreground="#555"/>
        </Border>
    </Grid>
</Window>
